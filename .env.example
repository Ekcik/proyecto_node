# Copiar como .env y completar localmente. Nunca publicar secretos.
PORT=3000
FIREBASE_PROJECT_ID=
# Ruta absoluta al JSON de cuenta de servicio, guardado fuera del repositorio.
# En Windows se pueden usar barras /: C:/Users/usuario/.config/techlab/service-account.json
GOOGLE_APPLICATION_CREDENTIALS=
ADMIN_USERNAME=
# Generar con npm run password:hash; no escribir la contraseña acá.
ADMIN_PASSWORD_HASH=
# Generar 32 bytes aleatorios como 64 caracteres hexadecimales (ver README).
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600
# Orígenes web permitidos separados por comas; vacío permite sólo el mismo origen.
# curl y Postman no requieren CORS.
CORS_ORIGINS=
